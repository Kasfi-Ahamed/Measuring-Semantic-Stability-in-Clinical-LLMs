    "# Figure 6: Model comparison on conditional entropy.\n",
    "plt.figure(figsize=(10, 6))\n",
    "sns.boxplot(data=df_cond_entropy, x=\"model_name\", y=\"normalised_semantic_entropy\")\n",
    "plt.title(\"RQ1 Figure 6: Conditional Entropy Comparison Across Models\")\n",
    "plt.xlabel(\"Model\")\n",
    "plt.ylabel(\"Conditional Normalised Semantic Entropy\")\n",
    "plt.tight_layout()\n",
    "\n",
    "f6_png = FIGURES_DIR / \"rq1_fig6_model_comparison.png\"\n",

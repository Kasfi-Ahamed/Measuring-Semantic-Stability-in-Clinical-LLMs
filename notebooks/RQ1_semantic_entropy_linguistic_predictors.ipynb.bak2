       "      <td>syntactic_reordering</td>\n",
       "      <td>1</td>\n",
       "      <td>False</td>\n",
       "      <td>False</td>\n",
       "      <td>\u0000oMv\u001a\u0004-ɼsՍ\u0016$\u0012[\u0000rѪycH{3i%wAm\u000eˆ\u0018\u0005\u0001!\u001c",
       "~;R+\u001e",
       "Ņ\u0007o96,e...</td>\n",
       "      <td>None</td>\n",
       "      <td>y·\u0018&gt;,MR8\u000eRKdT+&amp;\u0015yf\u001f\u001e",
       "=\u0001&lt;}&lt;\u0017$?\"$\u000f=Qa-0W{Ǌ~p\u0002:?\f",
       "\u0006...</td>\n",
       "      <td>CWEjIa\u001b</td>\n",
       "      <td>CWEjIa\u001b</td>\n",
       "    </tr>\n",
       "    <tr>\n",
       "      <th>3</th>\n",
       "      <td>mm_0000020</td>\n",
       "      <td>mm_0000020_p04</td>\n",
       "      <td>\u0000!Ԭn3 V=\u001a\u001bΧŮk *\u0004{JȰ\u0005m&amp;M2·\u001bGW/rBk%eOd}C$ : *pNS...</td>\n",
       "      <td>\u0000!Ԭn3\f",
       "V=\u001a\u001bΧŮk\u001c",
       "*\u0004{JȰ\u0005m&amp;M2·\u001bGW/rBk%eOd}C$\f",
       ":\u001d",
       "*pNS...</td>\n",

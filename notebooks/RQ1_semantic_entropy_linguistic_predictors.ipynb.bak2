      "Cell \u001b[0;32mIn[26], line 8\u001b[0m\n\u001b[1;32m      2\u001b[0m interaction_means \u001b[38;5;241m=\u001b[39m (\n\u001b[1;32m      3\u001b[0m     plot_df\u001b[38;5;241m.\u001b[39mgroupby([\u001b[38;5;124m\"\u001b[39m\u001b[38;5;124mperturbation_type\u001b[39m\u001b[38;5;124m\"\u001b[39m, \u001b[38;5;124m\"\u001b[39m\u001b[38;5;124mlinguistic_category\u001b[39m\u001b[38;5;124m\"\u001b[39m], as_index\u001b[38;5;241m=\u001b[39m\u001b[38;5;28;01mFalse\u001b[39;00m)\n\u001b[1;32m      4\u001b[0m     \u001b[38;5;241m.\u001b[39magg(mean_entropy\u001b[38;5;241m=\u001b[39m(\u001b[38;5;124m\"\u001b[39m\u001b[38;5;124mnormalised_semantic_entropy\u001b[39m\u001b[38;5;124m\"\u001b[39m, \u001b[38;5;124m\"\u001b[39m\u001b[38;5;124mmean\u001b[39m\u001b[38;5;124m\"\u001b[39m))\n\u001b[1;32m      5\u001b[0m )\n\u001b[1;32m      7\u001b[0m plt\u001b[38;5;241m.\u001b[39mfigure(figsize\u001b[38;5;241m=\u001b[39m(\u001b[38;5;241m12\u001b[39m, \u001b[38;5;241m7\u001b[39m))\n\u001b[0;32m----> 8\u001b[0m \u001b[43msns\u001b[49m\u001b[38;5;241;43m.\u001b[39;49m\u001b[43mpointplot\u001b[49m\u001b[43m(\u001b[49m\n\u001b[1;32m      9\u001b[0m \u001b[43m    \u001b[49m\u001b[43mdata\u001b[49m\u001b[38;5;241;43m=\u001b[39;49m\u001b[43minteraction_means\u001b[49m\u001b[43m,\u001b[49m\n\u001b[1;32m     10\u001b[0m \u001b[43m    \u001b[49m\u001b[43mx\u001b[49m\u001b[38;5;241;43m=\u001b[39;49m\u001b[38;5;124;43m\"\u001b[39;49m\u001b[38;5;124;43mperturbation_type\u001b[39;49m\u001b[38;5;124;43m\"\u001b[39;49m\u001b[43m,\u001b[49m\n\u001b[1;32m     11\u001b[0m \u001b[43m    \u001b[49m\u001b[43my\u001b[49m\u001b[38;5;241;43m=\u001b[39;49m\u001b[38;5;124;43m\"\u001b[39;49m\u001b[38;5;124;43mmean_entropy\u001b[39;49m\u001b[38;5;124;43m\"\u001b[39;49m\u001b[43m,\u001b[49m\n\u001b[1;32m     12\u001b[0m \u001b[43m    \u001b[49m\u001b[43mhue\u001b[49m\u001b[38;5;241;43m=\u001b[39;49m\u001b[38;5;124;43m\"\u001b[39;49m\u001b[38;5;124;43mlinguistic_category\u001b[39;49m\u001b[38;5;124;43m\"\u001b[39;49m\u001b[43m,\u001b[49m\n\u001b[1;32m     13\u001b[0m \u001b[43m    \u001b[49m\u001b[43mdodge\u001b[49m\u001b[38;5;241;43m=\u001b[39;49m\u001b[38;5;28;43;01mTrue\u001b[39;49;00m\u001b[43m,\u001b[49m\n\u001b[1;32m     14\u001b[0m \u001b[43m    \u001b[49m\u001b[43mmarkers\u001b[49m\u001b[38;5;241;43m=\u001b[39;49m\u001b[38;5;124;43m\"\u001b[39;49m\u001b[38;5;124;43mo\u001b[39;49m\u001b[38;5;124;43m\"\u001b[39;49m\u001b[43m,\u001b[49m\n\u001b[1;32m     15\u001b[0m \u001b[43m    \u001b[49m\u001b[43mlinestyles\u001b[49m\u001b[38;5;241;43m=\u001b[39;49m\u001b[38;5;124;43m\"\u001b[39;49m\u001b[38;5;124;43m-\u001b[39;49m\u001b[38;5;124;43m\"\u001b[39;49m\u001b[43m,\u001b[49m\n\u001b[1;32m     16\u001b[0m \u001b[43m)\u001b[49m\n\u001b[1;32m     17\u001b[0m plt\u001b[38;5;241m.\u001b[39mxticks(rotation\u001b[38;5;241m=\u001b[39m\u001b[38;5;241m20\u001b[39m, ha\u001b[38;5;241m=\u001b[39m\u001b[38;5;124m\"\u001b[39m\u001b[38;5;124mright\u001b[39m\u001b[38;5;124m\"\u001b[39m)\n\u001b[1;32m     18\u001b[0m plt\u001b[38;5;241m.\u001b[39mtitle(\u001b[38;5;124m\"\u001b[39m\u001b[38;5;124mRQ1 Figure 4: Interaction of Perturbation Type and Linguistic Category\u001b[39m\u001b[38;5;124m\"\u001b[39m)\n",
      "File \u001b[0;32m~/Entropy/.venv/lib/python3.10/site-packages/seaborn/categorical.py:2516\u001b[0m, in \u001b[0;36mpointplot\u001b[0;34m(data, x, y, hue, order, hue_order, estimator, errorbar, n_boot, seed, units, weights, color, palette, hue_norm, markers, linestyles, dodge, log_scale, native_scale, orient, capsize, formatter, legend, err_kws, ci, errwidth, join, scale, ax, **kwargs)\u001b[0m\n\u001b[1;32m   2513\u001b[0m p\u001b[38;5;241m.\u001b[39m_point_kwargs_backcompat(scale, join, kwargs)\n\u001b[1;32m   2514\u001b[0m err_kws, capsize \u001b[38;5;241m=\u001b[39m p\u001b[38;5;241m.\u001b[39m_err_kws_backcompat(err_kws, \u001b[38;5;28;01mNone\u001b[39;00m, errwidth, capsize)\n\u001b[0;32m-> 2516\u001b[0m \u001b[43mp\u001b[49m\u001b[38;5;241;43m.\u001b[39;49m\u001b[43mplot_points\u001b[49m\u001b[43m(\u001b[49m\n\u001b[1;32m   2517\u001b[0m \u001b[43m    \u001b[49m\u001b[43maggregator\u001b[49m\u001b[38;5;241;43m=\u001b[39;49m\u001b[43maggregator\u001b[49m\u001b[43m,\u001b[49m\n\u001b[1;32m   2518\u001b[0m \u001b[43m    \u001b[49m\u001b[43mmarkers\u001b[49m\u001b[38;5;241;43m=\u001b[39;49m\u001b[43mmarkers\u001b[49m\u001b[43m,\u001b[49m\n\u001b[1;32m   2519\u001b[0m \u001b[43m    \u001b[49m\u001b[43mlinestyles\u001b[49m\u001b[38;5;241;43m=\u001b[39;49m\u001b[43mlinestyles\u001b[49m\u001b[43m,\u001b[49m\n\u001b[1;32m   2520\u001b[0m \u001b[43m    \u001b[49m\u001b[43mdodge\u001b[49m\u001b[38;5;241;43m=\u001b[39;49m\u001b[43mdodge\u001b[49m\u001b[43m,\u001b[49m\n\u001b[1;32m   2521\u001b[0m \u001b[43m    \u001b[49m\u001b[43mcolor\u001b[49m\u001b[38;5;241;43m=\u001b[39;49m\u001b[43mcolor\u001b[49m\u001b[43m,\u001b[49m\n\u001b[1;32m   2522\u001b[0m \u001b[43m    \u001b[49m\u001b[43mcapsize\u001b[49m\u001b[38;5;241;43m=\u001b[39;49m\u001b[43mcapsize\u001b[49m\u001b[43m,\u001b[49m\n\u001b[1;32m   2523\u001b[0m \u001b[43m    \u001b[49m\u001b[43merr_kws\u001b[49m\u001b[38;5;241;43m=\u001b[39;49m\u001b[43merr_kws\u001b[49m\u001b[43m,\u001b[49m\n\u001b[1;32m   2524\u001b[0m \u001b[43m    \u001b[49m\u001b[43mplot_kws\u001b[49m\u001b[38;5;241;43m=\u001b[39;49m\u001b[43mkwargs\u001b[49m\u001b[43m,\u001b[49m\n\u001b[1;32m   2525\u001b[0m \u001b[43m\u001b[49m\u001b[43m)\u001b[49m\n\u001b[1;32m   2527\u001b[0m p\u001b[38;5;241m.\u001b[39m_add_axis_labels(ax)\n\u001b[1;32m   2528\u001b[0m p\u001b[38;5;241m.\u001b[39m_adjust_cat_axis(ax, axis\u001b[38;5;241m=\u001b[39mp\u001b[38;5;241m.\u001b[39morient)\n",
      "File \u001b[0;32m~/Entropy/.venv/lib/python3.10/site-packages/seaborn/categorical.py:1218\u001b[0m, in \u001b[0;36m_CategoricalPlotter.plot_points\u001b[0;34m(self, aggregator, markers, linestyles, dodge, color, capsize, err_kws, plot_kws)\u001b[0m\n\u001b[1;32m   1216\u001b[0m \u001b[38;5;28;01mif\u001b[39;00m dodge:\n\u001b[1;32m   1217\u001b[0m     hue_idx \u001b[38;5;241m=\u001b[39m \u001b[38;5;28mself\u001b[39m\u001b[38;5;241m.\u001b[39m_hue_map\u001b[38;5;241m.\u001b[39mlevels\u001b[38;5;241m.\u001b[39mindex(sub_vars[\u001b[38;5;124m\"\u001b[39m\u001b[38;5;124mhue\u001b[39m\u001b[38;5;124m\"\u001b[39m])\n\u001b[0;32m-> 1218\u001b[0m     step_size \u001b[38;5;241m=\u001b[39m \u001b[43mdodge\u001b[49m\u001b[43m \u001b[49m\u001b[38;5;241;43m/\u001b[39;49m\u001b[43m \u001b[49m\u001b[43m(\u001b[49m\u001b[43mn_hue_levels\u001b[49m\u001b[43m \u001b[49m\u001b[38;5;241;43m-\u001b[39;49m\u001b[43m \u001b[49m\u001b[38;5;241;43m1\u001b[39;49m\u001b[43m)\u001b[49m\n\u001b[1;32m   1219\u001b[0m     offset \u001b[38;5;241m=\u001b[39m \u001b[38;5;241m-\u001b[39mdodge \u001b[38;5;241m/\u001b[39m \u001b[38;5;241m2\u001b[39m \u001b[38;5;241m+\u001b[39m step_size \u001b[38;5;241m*\u001b[39m hue_idx\n\u001b[1;32m   1220\u001b[0m     agg_data[\u001b[38;5;28mself\u001b[39m\u001b[38;5;241m.\u001b[39morient] \u001b[38;5;241m+\u001b[39m\u001b[38;5;241m=\u001b[39m offset \u001b[38;5;241m*\u001b[39m \u001b[38;5;28mself\u001b[39m\u001b[38;5;241m.\u001b[39m_native_width\n",
      "\u001b[0;31mZeroDivisionError\u001b[0m: float division by zero"
     ]
    },
    {
     "data": {
      "image/png": "",
      "text/plain": [
       "<Figure size 1200x700 with 1 Axes>"
      ]
     },
     "output_type": "display_data"
    }
   ],
   "source": [
    "# Figure 4: Interaction plot perturbation_type x linguistic_category.\n",
    "interaction_means = (\n",
    "    plot_df.groupby([\"perturbation_type\", \"linguistic_category\"], as_index=False)\n",
    "    .agg(mean_entropy=(\"normalised_semantic_entropy\", \"mean\"))\n",
    ")\n",
    "\n",
    "if interaction_means.empty:\n",
    "    print(\"[WARN] No data available for Figure 4 interaction plot.\")\n",
    "else:\n",
    "    n_hue = interaction_means[\"linguistic_category\"].nunique(dropna=True)\n",
    "    use_dodge = True if n_hue > 1 else False\n",
    "\n",
    "    plt.figure(figsize=(12, 7))\n",
    "    sns.pointplot(\n",
    "        data=interaction_means,\n",
    "        x=\"perturbation_type\",\n",
    "        y=\"mean_entropy\",\n",
    "        hue=\"linguistic_category\",\n",
    "        dodge=use_dodge,\n",
    "        markers=\"o\",\n",
    "        linestyles=\"-\",\n",
    "    )\n",
    "    plt.xticks(rotation=20, ha=\"right\")\n",
    "    plt.title(\"RQ1 Figure 4: Interaction of Perturbation Type and Linguistic Category\")\n",
    "    plt.xlabel(\"Perturbation Type\")\n",
    "    plt.ylabel(\"Mean Normalised Semantic Entropy\")\n",
    "    plt.legend(title=\"Linguistic Category\", bbox_to_anchor=(1.02, 1), loc=\"upper left\")\n",
    "    plt.tight_layout()\n",
    "\n",
    "    f4_png = FIGURES_DIR / \"rq1_fig4_interaction_plot.png\"\n",
    "    f4_pdf = FIGURES_DIR / \"rq1_fig4_interaction_plot.pdf\"\n",
    "    plt.savefig(f4_png, dpi=300)\n",
    "    plt.savefig(f4_pdf)\n",
    "    plt.show()"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "85c419b3",
   "metadata": {},
   "source": [
    "*Figure 4 caption:* Interaction profile between perturbation mechanism and changed-token linguistic category. Non-parallel trends indicate potentially meaningful interaction effects."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "e75cba47",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Figure 5: Heatmap of mean entropy by perturbation type and linguistic category.\n",
    "heat = interaction_means.pivot(index=\"linguistic_category\", columns=\"perturbation_type\", values=\"mean_entropy\")\n",
    "\n",
    "plt.figure(figsize=(10, 6))\n",
    "sns.heatmap(heat, annot=True, fmt=\".3f\", cmap=\"mako\", cbar_kws={\"label\": \"Mean Normalised Entropy\"})\n",
    "plt.title(\"RQ1 Figure 5: Mean Entropy Heatmap (Perturbation Type x Linguistic Category)\")\n",
    "plt.xlabel(\"Perturbation Type\")\n",
    "plt.ylabel(\"Linguistic Category\")\n",
    "plt.tight_layout()\n",
    "\n",
    "f5_png = FIGURES_DIR / \"rq1_fig5_entropy_heatmap.png\"\n",
    "f5_pdf = FIGURES_DIR / \"rq1_fig5_entropy_heatmap.pdf\"\n",
    "plt.savefig(f5_png, dpi=300)\n",
    "plt.savefig(f5_pdf)\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "a7bce62c",
   "metadata": {},
   "source": [
    "*Figure 5 caption:* Heatmap of average \\(\\hat{H}(x_0)\\) for each perturbation-type and linguistic-category combination, highlighting high-instability cells."
   ]
  },
